# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit your real token.
#
# Load it for a local run with:
#   set -a && source .env && set +a && python3 digest.py

# From @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here

# Your numeric chat ID (see README step 2)
TELEGRAM_CHAT_ID=000000000

# How many Hacker News stories to include (optional, default 5)
HN_COUNT=5

# Semantic Scholar API key — optional, but strongly recommended.
# The anonymous tier is a shared global bucket (~1 req/sec for ALL unauthenticated
# users), so most requests come back 429. A free key gives you a private quota.
# Request one at: https://www.semanticscholar.org/product/api#api-key
S2_API_KEY=

# Seconds between API requests (optional). Defaults to 1.0 with a key, 3.5 without.
# LINALG_REQUEST_GAP=3.5

# Publication years to consider (optional, default 2015-2026). Old enough to have
# accumulated citations, recent enough to still matter.
# LINALG_YEAR_RANGE=2015-2026
